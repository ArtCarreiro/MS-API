        { "name": "Delete Address", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/address/{{addressUuid}}", "host": ["{{baseUrl}}"], "path": ["address", "{{addressUuid}}"] } }, "response": [] }
      ]
    },
