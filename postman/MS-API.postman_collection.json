      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload Product File",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });", "if (pm.response.code >= 200 && pm.response.code < 300) { const body = pm.response.json(); if (body.uuid) pm.collectionVariables.set('fileUuid', body.uuid); }"] } }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{uploadFilePath}}" },
                { "key": "name", "value": "produto-{{timestamp}}.jpg", "type": "text" },
                { "key": "product.uuid", "value": "{{productUuid}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/files/{{productUuid}}", "host": ["{{baseUrl}}"], "path": ["files", "{{productUuid}}"] },
            "description": "Ajuste uploadFilePath para um arquivo local existente. Se este endpoint retornar erro de binding, veja FileController: a rota usa /{uuid}, mas o parametro Java chama productUuid; tambem mistura MultipartFile com @RequestBody."
          },
          "response": []
        }
