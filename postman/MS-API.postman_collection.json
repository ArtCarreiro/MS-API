          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"street\": \"Av. Paulista, 1000\",\n  \"neighborhood\": \"Bela Vista\",\n  \"country\": \"Brasil\",\n  \"zipCode\": \"01310100\",\n  \"complement\": \"Apto 101\",\n  \"customer\": {\n    \"uuid\": \"{{customerUuid}}\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/address", "host": ["{{baseUrl}}"], "path": ["address"] },
            "description": "Execute Create Customer antes para preencher customerUuid."
          },
          "response": []
        },
        { "name": "Get Address By UUID", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/address/{{addressUuid}}", "host": ["{{baseUrl}}"], "path": ["address", "{{addressUuid}}"] } }, "response": [] },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"street\": \"Rua Augusta, 500\",\n  \"neighborhood\": \"Consolacao\",\n  \"country\": \"Brasil\",\n  \"zipCode\": \"01305000\",\n  \"complement\": \"Casa 2\",\n  \"customer\": {\n    \"uuid\": \"{{customerUuid}}\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/address/{{addressUuid}}", "host": ["{{baseUrl}}"], "path": ["address", "{{addressUuid}}"] }
          },
          "response": []
